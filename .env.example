# Copy to .env. Use the endpoint and exact model name from your provider console.
# Example: a provider's OpenAI-compatible base URL, ending in /v1 or /compatible-mode/v1.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional image-capable model on the same endpoint and account.
VISION_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=8192
LLM_JSON_MODE=true
# Optional provider parameters, e.g. {"enable_thinking":false}
LLM_EXTRA_BODY={}
# For self-hosted gateways only; explicitly list allowed HTTP hostnames.
LLM_HTTP_HOSTS=
LLM_ALLOW_NO_KEY=false
# Direct Python execution can read a secret file instead of LLM_API_KEY.
# LLM_API_KEY_FILE=/absolute/path/to/key.txt
# Docker uses fixed internal host/port/data; only APP_PORT changes its host port.
APP_PORT=8765
HOST=127.0.0.1
PORT=8765
DATA_DIR=./data
